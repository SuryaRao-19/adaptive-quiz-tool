{
  "name": "adaptive-quiz-server",
  "version": "1.0.0",
  "description": "Backend server for Adaptive Quiz and Practice Tool",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedPostgres.js",
    "seed:legacy": "node scripts/seedManual.js",
    "migrate:pg": "prisma migrate dev",
    "migrate:from-mongo": "node scripts/migrateFromMongo.js",
    "backup": "node scripts/backupDb.js",
    "restore": "node scripts/restoreDb.js",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.4.1"
  }
}
