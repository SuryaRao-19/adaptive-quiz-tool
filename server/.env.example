# ==============================================================================
# AdaptIQ Backend Environment Variables (.env.example)
# Copy to .env and supply actual keys and credentials. Placeholders only.
# ==============================================================================

# Server HTTP Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptiq_db?schema=public

# Legacy MongoDB Connection String (Optional fallback during phased transition)
MONGODB_URI=mongodb://localhost:27017/adaptive_quiz_db

# Client origin for CORS security policy
CLIENT_URL=http://localhost:5173

# JWT Secret Token Signing Key (generate with `openssl rand -base64 32`)
JWT_SECRET=your_secure_jwt_secret_change_in_production

# JWT Token Expiration Window
JWT_EXPIRES_IN=7d

# Offline Classroom Gateway Settings
GATEWAY_MODE=false
LOCAL_LAN_BIND=127.0.0.1
CONTENT_BUNDLE_VERSION=2.0.0-stem-offline

# Google Gemini AI Service Configuration (Server-side only — never expose to client or frontend bundles)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# Multi-Provider AI Gateway & Intelligent Model Router
AI_ROUTING_MODE=auto                # 'auto' or 'manual'
AI_PRIMARY_PROVIDER=gemini          # 'gemini', 'openai', 'anthropic', or 'ollama'
AI_FALLBACK_ENABLED=true            # enable automatic fallback cascade

# Optional Secondary Providers
OPENAI_API_KEY=                     # your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=                  # your_anthropic_api_key_here
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022
OLLAMA_HOST=http://localhost:11434  # local Ollama daemon
OLLAMA_DEFAULT_MODEL=llama3.2

# Granular AI Timeouts (ms)
AI_CONNECTION_TIMEOUT_MS=10000      # 10s connection establishment limit
AI_FIRST_TOKEN_TIMEOUT_MS=20000     # 20s initial chunk stream limit
AI_IDLE_STREAM_TIMEOUT_MS=20000     # 20s inter-chunk idle limit
AI_MAX_GENERATION_MS=120000         # 120s max completion generation time

# Legacy AI Provider alias fallback
AI_PROVIDER=gemini
AI_API_KEY=your_actual_gemini_api_key_here
AI_MODEL=gemini-3.8-flash

# Web3Forms Access Key for Contact & Support Inquiries
WEB3FORMS_ACCESS_KEY=

