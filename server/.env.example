# ==============================================================================
# AdaptIQ Backend Environment Variables (.env.example)
# Copy to .env and supply actual keys and credentials. Placeholders only.
# ==============================================================================

# Server HTTP Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptiq_db?schema=public

# Legacy MongoDB Connection String (Optional fallback during phased transition)
MONGODB_URI=mongodb://localhost:27017/adaptive_quiz_db

# Client origin for CORS security policy
CLIENT_URL=http://localhost:5173

# JWT Secret Token Signing Key (generate with `openssl rand -base64 32`)
JWT_SECRET=your_secure_jwt_secret_change_in_production

# JWT Token Expiration Window
JWT_EXPIRES_IN=7d

# Offline Classroom Gateway Settings
GATEWAY_MODE=false
LOCAL_LAN_BIND=127.0.0.1
CONTENT_BUNDLE_VERSION=2.0.0-stem-offline

# AI Tutor Provider Key (Server-side only — never exposed to client)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Web3Forms Access Key for Contact & Support Inquiries
WEB3FORMS_ACCESS_KEY=

